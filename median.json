      "active": true,
      "rules": [
        {
          "id": 1,
          "regex": "^(?!https?://).*",
          "mode": "external",
          "label": "Non-web links",
          "pagesToTrigger": "custom"
        },
        {
          "id": 2,
          "regex": "https?://([-\\w]+\\.)*facebook\\.com.*",
          "mode": "appbrowser",
          "label": "Facebook",
          "pagesToTrigger": "custom"
        },
        {
          "id": 3,
          "regex": "https?://([\\-\\w]+\\.)*(twitter|x)\\.com/.*",
          "mode": "appbrowser",
          "label": "Twitter/X",
          "pagesToTrigger": "custom"
        },
        {
          "id": 4,
          "regex": "https?://([-\\w]+\\.)*instagram\\.com/.*",
          "mode": "appbrowser",
          "label": "Instagram",
          "pagesToTrigger": "custom"
        },
        {
          "id": 5,
          "regex": "https?://maps\\.google\\.com.*",
          "mode": "appbrowser",
          "label": "Google Maps",
          "pagesToTrigger": "custom"
        },
        {
          "id": 6,
          "regex": "https?://([-\\w]+\\.)*google\\.com/maps/search/.*",
          "mode": "appbrowser",
          "label": "Google Maps Search",
          "pagesToTrigger": "custom"
        },
        {
          "id": 7,
          "regex": "https?://([-\\w]+\\.)*linkedin\\.com/.*",
          "mode": "appbrowser",
          "label": "LinkedIn",
          "pagesToTrigger": "custom"
        },
        {
          "id": 8,
          "regex": "https?://login\\.microsoftonline\\.com.*",
          "mode": "internal",
          "label": "Microsoft Login",
          "pagesToTrigger": "custom"
        },
        {
          "id": 9,
          "regex": "https?:\\/\\/([-\\w]+\\.)*nextgencms.workers.dev(\\/.*)?$",
          "mode": "internal",
          "label": "All pages on my domain",
          "pagesToTrigger": "domain"
        },
        {
          "id": 10,
          "regex": "https?://accounts\\.google\\.com/.*",
          "mode": "internal",
          "label": "Google Accounts Login",
          "pagesToTrigger": "custom"
        },
        {
          "id": 11,
          "regex": "https?://([-\\w]+\\.)*firebaseapp\\.com/.*",
          "mode": "internal",
          "label": "Firebase Auth Handlers",
          "pagesToTrigger": "custom"
        },
        {
          "id": 12,
          "regex": "https?://apis\\.google\\.com/.*",
          "mode": "internal",
          "label": "Google APIs Auth",
          "pagesToTrigger": "custom"
        },
        {
          "id": 13,
          "regex": "https?://([-\\w]+\\.)*googleusercontent\\.com/.*",
          "mode": "internal",
          "label": "Google User Content",
          "pagesToTrigger": "custom"
        },
        {
          "id": 14,
          "regex": ".*",
          "mode": "appbrowser",
          "label": "All Other Links",
          "pagesToTrigger": "all"
        }
      ]
    },
