{
  "name": "nextgencms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --remote",
    "dev:local-mssql": "tsx watch server.ts",
    "build": "vite build",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint .",
    "d1:init:local": "wrangler d1 execute nextgencms --local --file=./schema_d1.sql",
    "d1:init": "wrangler d1 execute nextgencms --remote --file=./schema_d1.sql",
    "d1:pull": "tsx scripts/pull_from_d1.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/mssql": "^12.3.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msnodesqlv8": "^5.3.0",
    "mssql": "^12.7.1",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.2.0",
    "wrangler": "^4.132.0"
  }
}
